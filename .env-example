# =================================================================
# CONFIGURACIÓN GENERAL DE CORTEX XDR
# =================================================================
FQDN=ejemplo.xdr.us.paloaltonetworks.com
AUTH_ID=1
AUTH_KEY=xdr_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Definición de Endpoints ---
# Endpoint 1: Alertas
API_NAME1=detects
API_CALL1=get_alerts_multi_events

# Endpoint 2: Auditoría (Logs de gestión)
API_NAME2=audits
API_CALL2=get_audit_management_logs

# Endpoint 3: Incidentes
API_NAME3=incidents
API_CALL3=get_incidents

# =================================================================
# CONFIGURACIÓN DE TIEMPO Y LÓGICA
# =================================================================

# Ventana de tiempo hacia atrás para buscar eventos (en segundos)
# 300 segundos = 5 minutos.
TIME_OFFSET_SECONDS=300

# ¿Descargar logs de auditoría? (true/false)
ENABLE_AUDIT=true

# =================================================================
# FILTRADO DE TAGS
# =================================================================

# Lista de tags separados por comas.
# Si dejas esto vacío, traerá TODOS los eventos.
# Si pones tags, solo traerá eventos que tengan al menos uno de estos.
# Ejemplo: FILTER_TAGS=Critical_Server, DMZ_Assets, VIP_Users
FILTER_TAGS=

# =================================================================
# CONFIGURACIÓN DE ENVÍO DE LOGS (OUTPUTS)
# =================================================================

# --- 1. ENVÍO VÍA UDP (Syslog Estándar) ---
UDP_ENABLED=true
UDP_HOST=127.0.0.1
UDP_PORT=514

# --- 2. ENVÍO VÍA TCP ---
# Nota: TCP suele usar puerto 514 o 601. Asegúrate que tu servidor escuche TCP.
TCP_ENABLED=true
TCP_HOST=127.0.0.1
TCP_PORT=601

# --- 3. ENVÍO SOCKET WAZUH ---
WAZUH_SOCKET_ENABLED=false
WAZUH_SOCKET_PATH=/var/ossec/queue/sockets/queue

# =================================================================
# ARCHIVOS DE LOG LOCALES (Rotación y Almacenamiento)
# =================================================================
ALERTS_LOG_FILE=/opt/cortex-xdr/alerts.log
AUDITS_LOG_FILE=/opt/cortex-xdr/audits.log
INCIDENTS_LOG_FILE=/opt/cortex-xdr/incidents.log
APP_LOG_FILE=/opt/cortex-xdr/cortex_xdr_app.log
